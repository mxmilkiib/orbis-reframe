/* orbis-reframe stylesheet. A template: every @-name below (@window,
   @accent, ...) is replaced by the current theme's colour (src/ui/Theme.h
   lists the tokens, Theme.cpp the values) before theme::apply() sets it
   app-wide. No colour is written here
   directly, so a theme is only a set of token values. One flat stylesheet --
   no external style dependency, works identically under Sway where there is
   no system theme. Links in rich text get the accent from the palette
   (theme::apply): a stylesheet can't colour them.
*/

/* No background here: containers sit on what's behind them, and windows
   and dialogs fill with the palette's window colour (theme::apply). A
   background on every QWidget would paint each row of a panel in the
   window colour. */
QWidget {
    color: @text;
    font-size: 13px;
    selection-background-color: @accent;
    selection-color: @textOnAccent;
}

QToolTip {
    background-color: @button;
    color: @text;
    border: 1px solid @border;
    padding: 3px 6px;
}

/* ---- Menu bar ---- */
QMenuBar {
    background-color: @menuBar;
    border-bottom: 1px solid @border;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}
QMenuBar::item:selected {
    background-color: @button;
}
QMenu {
    background-color: @panel;
    border: 1px solid @border;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: @accentSoft;
    color: @text;
}
QMenu::item:disabled {
    color: @textDisabled;
}
QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 4px 6px;
}
QMenu::icon {
    padding-left: 8px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: @button;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: @border;
}
QPushButton:pressed {
    background-color: @pressed;
}
QPushButton:checked {
    background-color: @accentSoft;
    border-color: @accent;
}
QPushButton:default {
    border-color: @accent;
}
QPushButton:disabled {
    color: @textDisabled;
    background-color: @panel;
    border-color: @border;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}
QToolButton:hover {
    background-color: @button;
    border-color: @border;
}
QToolButton:pressed {
    background-color: @pressed;
}
QToolButton:checked {
    background-color: @accentSoft;
    border-color: @accent;
}
QToolButton:disabled {
    background: transparent;
    border-color: transparent;
}

/* ---- Inputs ---- */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 18px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: @borderHover;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: @accent;
}
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QLineEdit:disabled {
    color: @textDisabled;
    background-color: @window;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background-color: @panel;
    border: 1px solid @border;
    selection-background-color: @accentSoft;
    outline: none;
}

/* ---- Sliders (transport / misc) ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: @border;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: @icon;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover {
    background: @accent;
}
QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 2px;
}
QSlider::handle:horizontal:disabled {
    background: @textDisabled;
}
QSlider::sub-page:horizontal:disabled {
    background: @border;
}

/* ---- Checkboxes / radio ---- */
QCheckBox, QRadioButton {
    spacing: 6px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @borderHover;
    border-radius: 3px;
    background: @panel;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @accent;
    border-color: @accent;
}
QRadioButton::indicator {
    border-radius: 8px;
}

/* ---- Scroll areas / bars ---- */
QScrollArea {
    border: none;
}
QScrollBar:vertical {
    background: @window;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @border;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @borderHover;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: @window;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @border;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: @borderHover;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Progress dialog (export) ---- */
QProgressBar {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: @accent;
    border-radius: 3px;
}

/* ================= Settings sections (the right sidebar's tabs) ================= */

/* A section's header row: chevron, title, and what it applies to. */
QToolButton[settingsPart="header"] {
    font-size: 13px;
    font-weight: 600;
    color: @text;
    text-align: left;
    padding: 9px 10px 9px 10px;
    border: none;
    border-radius: 0;
    border-top: 1px solid @border;
    background-color: transparent;
}
QToolButton[settingsPart="header"][collapsible="true"]:hover {
    background-color: @menuBar;
}
#settingsPanelScope {
    color: @textDim;
    font-size: 11px;
    font-weight: normal;
}
#settingsPanelHint {
    color: @textDim;
    padding: 0 14px 12px 14px;
}
#settingsPanelBody, #settingsPageContent {
    background-color: @panel;
}
#settingsPanelBody QLabel {
    color: @textDim;
}

/* Media information panel: section headers and read-only values. */
#settingsPanelBody QLabel#mediaInfoSection {
    color: @text;
    font-weight: 600;
    padding-top: 6px;
}
#settingsPanelBody QLabel#mediaInfoValue {
    color: @text;
}

/* ================= Tab sidebars (left: sources, right: settings) ================= */

TabSidebar {
    background-color: @panel;
}
TabSidebar[sidebarSide="left"] {
    border-right: 1px solid @border;
}
TabSidebar[sidebarSide="right"] {
    border-left: 1px solid @border;
}
/* The icon tabs along the top. */
QWidget[sidebarPart="tabRow"] {
    background-color: @menuBar;
    border-bottom: 1px solid @border;
}
QWidget[sidebarPart="tabRow"] QToolButton {
    border: none;
    border-radius: 0;
    padding: 7px;
    border-bottom: 2px solid transparent;
}
QWidget[sidebarPart="tabRow"] QToolButton:hover {
    background-color: @panel;
}
QWidget[sidebarPart="tabRow"] QToolButton:checked {
    background-color: @panel;
    border-bottom: 2px solid @accent;
}
/* The resize handle on the inner edge: shows on hover. */
QWidget[sidebarPart="handle"] {
    background-color: transparent;
}
QWidget[sidebarPart="handle"]:hover {
    background-color: @accent;
}
/* Between the viewer and the timeline: a border line, the accent on hover. */
QSplitter#editorSplitter::handle:vertical {
    background-color: @border;
    height: 3px;
}
QSplitter#editorSplitter::handle:vertical:hover {
    background-color: @accent;
}
/* Closed: the slim strip at the edge. */
QWidget[sidebarPart="strip"] {
    background-color: @menuBar;
}
QWidget[sidebarPart="strip"] QToolButton {
    border: none;
    border-radius: 0;
    padding: 4px 1px;
}
QWidget[sidebarPart="strip"] QToolButton:hover {
    background-color: @panel;
}
#sidebarPageTitle {
    font-size: 13px;
    font-weight: 600;
    color: @text;
    padding: 10px 12px 8px 12px;
}

/* Media tab. */
#mediaPoolPanel, #mediaPoolList {
    background-color: @panel;
}
#mediaPoolStatus {
    color: @textDim;
    padding: 0 12px 6px 12px;
}

/* Titles tab. */
#titlesPanel, #titleList {
    background-color: @panel;
}
#titlesHint {
    color: @textDim;
    padding: 0 12px 8px 12px;
}

/* Transitions tab. */
#transitionsPanel, #transitionList {
    background-color: @panel;
}
#transitionsHint {
    color: @textDim;
    padding: 0 12px 8px 12px;
}
#transitionNote {
    color: @warning;
}

/* ================= Project library (start screen) ================= */

#projectLibrary {
    background-color: @window;
}
#projectLibraryTitle {
    font-size: 18px;
    font-weight: 600;
}
#projectList {
    background-color: @window;
}
#projectLibraryEmpty, #projectsFolderLabel {
    color: @textDim;
}

/* ---- Dialogs: section headings, hints, a line that turns into a problem ---- */
QLabel#dialogSection {
    font-weight: 600;
    padding-top: 8px;
}
QLabel#dialogHint, QLabel#projectFolderResult {
    color: @textDim;
}
QLabel#projectFolderResult[problem="true"] {
    color: @error;
}

/* The player bar under the viewport. */
#playerBar {
    background-color: @menuBar;
    border-top: 1px solid @border;
}
QToolButton#playerSpeed::menu-indicator {
    image: none;
    width: 0;
}
#playerBuffering {
    color: @textDim;
}
