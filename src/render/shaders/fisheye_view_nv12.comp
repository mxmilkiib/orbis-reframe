#version 450
#extension GL_GOOGLE_include_directive : require

// Fused fisheye -> view render: each output pixel of the flat
// (rectilinear) view samples the two NV12 fisheye lenses directly, with no
// equirect in between. One resample instead of the stitch + reproject pair
// (fisheye_stitch_nv12.comp, then reframe_reproject.comp), and the cost
// follows the output's pixel count, not the sphere's.
//
// Dispatched twice per frame, like the stitch (plus pass 2, the seam cost
// volume, in its own submission when the depth-aware seam is on):
//   pass 0 -- photometric measure over the SAME sphere grid the equirect
//             stitch measures (every 8th texel of a P.dims.z x P.dims.w
//             equirect; one invocation per grid point), so the seam gains
//             match the equirect path exactly;
//   pass 1 -- the view: pixel -> view ray (pose, then stab; identical to
//             reframe_reproject.comp / equirect.frag) -> stitch direction ->
//             blended lenses -> colour grade -> out.
//
// Output (binding 3, uint px[]), 4 horizontal pixels per invocation, so outW
// must be a multiple of 4 (and outH of 2 for NV12):
//   fmt 0: tightly-packed BT.709 limited-range NV12 (export -> NVENC);
//   fmt 1: RGBA8, one uint per pixel (viewport / stills / comparison);
//   fmt 2: P010 -- as NV12 but 16-bit samples (the 10-bit code << 6), two
//          per uint (export -> Main 10 hardware encoders).

layout(local_size_x = 16, local_size_y = 4) in;

layout(binding = 1) uniform sampler2D lens0; // ycbcr-conversion sampler (immutable)
layout(binding = 2) uniform sampler2D lens1;

vec3 sampleLens(int i, vec2 uv)
{
    return (i == 0 ? texture(lens0, uv) : texture(lens1, uv)).rgb * 255.0;
}

layout(push_constant) uniform PC {
    int pass;
    int outW;
    int outH;
    int fmt; // 0 = NV12, 1 = RGBA
    float yaw;
    float pitch;
    float roll;
    float fovY;
    float aspect;
    // RGBA only: where the view goes in a larger canvas (several views in
    // one buffer, VulkanFisheyeStitcher::renderViewsVk) -- its top-left
    // pixel (ox a multiple of 4) and the canvas row length in pixels; 0 =
    // the view alone, outW per row. (Fills what was mat3 alignment padding.)
    int ox;
    int oy;
    int stride;
    mat3 stab; // gyro de-rotation in the sphere frame, after the pose
    vec4 colorGrade; // exposureEv, contrast%, saturation%, temperature%
} pc;

#define FISHEYE_STITCH_NO_MAIN
#include "fisheye_stitch_common.glsl"

// The same output buffer seen as 16-byte words: the RGBA path stores its 4
// pixels in one write. The buffer is host memory, written over PCIe, and four
// strided 4-byte stores per thread don't coalesce -- 45 ms vs ~0.3 ms for a
// 1080p frame (tools/playback_bench).
layout(std430, binding = 3) writeonly buffer OutBuf4 { uvec4 px4[]; };

#include "color_grade.glsl"

// Output pixel -> sphere (equirect-frame) direction. Same as
// reframe_reproject.comp's dirFor(): view ray from the FOV, roll about Z,
// pitch about X, yaw about Y, then stab.
vec3 viewDir(int px, int py)
{
    float ndcX = (float(px) + 0.5) / float(pc.outW) * 2.0 - 1.0;
    float ndcY = (float(py) + 0.5) / float(pc.outH) * 2.0 - 1.0;
    float t = tan(pc.fovY * 0.5);
    vec3 r = normalize(vec3(ndcX * t * pc.aspect, -ndcY * t, -1.0));

    float cr = cos(pc.roll), sr = sin(pc.roll);
    float cp = cos(pc.pitch), sp = sin(pc.pitch);
    float cy = cos(pc.yaw), sy = sin(pc.yaw);

    vec3 rr = vec3(r.x * cr - r.y * sr, r.x * sr + r.y * cr, r.z);
    vec3 rp = vec3(rr.x, rr.y * cp - rr.z * sp, rr.y * sp + rr.z * cp);
    return normalize(pc.stab * vec3(rp.x * cy + rp.z * sy, rp.y, -rp.x * sy + rp.z * cy));
}

// The equirect stitch maps texel (lon, lat) to (cl sin lon, sl, -cl cos lon)
// -- which IS the sphere direction -- then rotates it by outRot. So a view
// ray goes to the stitch world by outRot alone.
vec3 stitchDir(vec3 sphereDir)
{
    return mul3(P.outRot[0], P.outRot[1], P.outRot[2], sphereDir);
}

float g0, g1; // photometric gains, per invocation

vec3 shade(int px, int py)
{
    return gradeColor(blurredLenses(stitchDir(viewDir(px, py)), g0, g1), pc.colorGrade, 255.0);
}

// BT.709 limited range, as reframe_reproject.comp.
float lumaY(vec3 c) { return 16.0 + 0.182586 * c.r + 0.614231 * c.g + 0.062007 * c.b; }
float chromaU(vec3 c) { return 128.0 - 0.100644 * c.r - 0.338572 * c.g + 0.439216 * c.b; }
float chromaV(vec3 c) { return 128.0 + 0.439216 * c.r - 0.398942 * c.g - 0.040274 * c.b; }
uint q8(float x) { return uint(clamp(x + 0.5, 0.0, 255.0)); }
// The 8-bit-scale value x4 in the high bits of a 16-bit P010 sample.
uint q16(float x) { return uint(clamp(x * 4.0 + 0.5, 0.0, 1023.0)) << 6; }

void main()
{
    if (pc.pass == 2) { // depth-aware seam cost volume (fisheye_stitch_common.glsl)
        seamCostPass(gl_WorkGroupID, gl_LocalInvocationIndex);
        return;
    }
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);

    if (pc.pass == 0) {
        // One invocation per measure-grid point: texel (8x, 8y) of the
        // P.dims.z x P.dims.w equirect, as the stitch's pass 0 samples.
        int W = P.dims.z, H = P.dims.w;
        ivec2 t = gid * 8;
        if (t.x >= W || t.y >= H)
            return;
        measureAt(eqTexelDir(t, W, H));
        return;
    }

    int quads = pc.outW / 4;
    if (gid.x >= quads || gid.y >= pc.outH)
        return;
    photoGains(g0, g1);
    int basePx = gid.x * 4;

    if (pc.fmt == 1) {
        uint w[4];
        for (int i = 0; i < 4; ++i) {
            uvec3 q = uvec3(clamp(shade(basePx + i, gid.y) + 0.5, vec3(0.0), vec3(255.0)));
            w[i] = q.r | (q.g << 8) | (q.b << 16) | (255u << 24);
        }
        int stride = pc.stride > 0 ? pc.stride : pc.outW;
        px4[((gid.y + pc.oy) * stride + pc.ox + basePx) / 4] = uvec4(w[0], w[1], w[2], w[3]);
        return;
    }

    vec3 rgb[4];
    for (int i = 0; i < 4; ++i)
        rgb[i] = shade(basePx + i, gid.y);

    if (pc.fmt == 2) {
        // P010: one 16-bit word per luma sample (2 px per uint).
        uint yb = uint(gid.y * pc.outW + basePx) / 2;
        px[yb] = q16(lumaY(rgb[0])) | (q16(lumaY(rgb[1])) << 16);
        px[yb + 1] = q16(lumaY(rgb[2])) | (q16(lumaY(rgb[3])) << 16);
    } else {
        uint y[4];
        for (int i = 0; i < 4; ++i)
            y[i] = q8(lumaY(rgb[i]));
        px[gid.y * quads + gid.x] = y[0] | (y[1] << 8) | (y[2] << 16) | (y[3] << 24);
    }

    // 4:2:0 chroma: even rows write one sample per 2x2 block, averaging this
    // row and the next.
    if ((gid.y & 1) == 0) {
        int nextY = gid.y + 1 < pc.outH ? gid.y + 1 : gid.y;
        vec3 n0 = shade(basePx + 0, nextY);
        vec3 n1 = shade(basePx + 1, nextY);
        vec3 n2 = shade(basePx + 2, nextY);
        vec3 n3 = shade(basePx + 3, nextY);
        vec3 c0 = (rgb[0] + rgb[1] + n0 + n1) * 0.25;
        vec3 c1 = (rgb[2] + rgb[3] + n2 + n3) * 0.25;
        if (pc.fmt == 2) {
            // P010: a (u,v) pair is one uint -- u in the low word, v high.
            uint uvb = uint(pc.outW * pc.outH + (gid.y >> 1) * pc.outW + basePx) / 2;
            px[uvb] = q16(chromaU(c0)) | (q16(chromaV(c0)) << 16);
            px[uvb + 1] = q16(chromaU(c1)) | (q16(chromaV(c1)) << 16);
        } else {
            uint u0 = q8(chromaU(c0)), v0 = q8(chromaV(c0));
            uint u1 = q8(chromaU(c1)), v1 = q8(chromaV(c1));
            int uvBase = pc.outH * quads;
            px[uvBase + (gid.y >> 1) * quads + gid.x] = u0 | (v0 << 8) | (u1 << 16) | (v1 << 24);
        }
    }
}
