#version 450
#extension GL_GOOGLE_include_directive : require

// Equirect -> rectilinear ("flat") reproject for the export pipeline, straight
// on the GPU: reads the equirect the fisheye stitch just wrote (still the
// std430 RGBA-uint OutBuf, never downloaded), reprojects it against a baked
// {yaw,pitch,roll,fovY} pose plus a per-frame stabilization matrix --
// identical ray math to the interactive viewport
// (src/render/shaders/equirect.frag) -- and writes BT.709
// limited-range NV12 into a host-visible buffer that goes straight to NVENC.
//
// No CPU reproject, no swscale. Replaces exportpipe::ReframeRenderer +
// sws_scale on the all-GPU export path.
//
// Packing: one invocation per Y-plane uint = 4 horizontal luma pixels, so
// outW must be a multiple of 4 and outH a multiple of 2 (every export preset
// is). FlatBuf is [Y: outH*(outW/4) uints][UV: (outH/2)*(outW/4) uints], which
// is exactly tightly-packed NV12 (row stride == width) in little-endian.

layout(local_size_x = 16, local_size_y = 4) in;

layout(std430, binding = 0) readonly buffer EqBuf { uint eqpx[]; };
layout(std430, binding = 1) writeonly buffer FlatBuf { uint outw[]; };

layout(push_constant) uniform PC {
    int eqW;
    int eqH;
    int outW;
    int outH;
    float yaw;
    float pitch;
    float roll;
    float fovY;
    float aspect;
    // 12 bytes of padding here (4 ints + 5 floats -> mat3 aligns at offset 48).
    mat3 stab; // gyro de-rotation in the sphere frame, applied to the world ray
               // AFTER the reframe pose (same as equirect.frag). Identity = off.
    // Colour panel: x=exposureEv (stops), y=contrast (%), z=saturation (%),
    // w=temperature (%). All 0 = neutral. Applied by color_grade.glsl.
    vec4 colorGrade;
    vec4 colorLut;   // the clip's LUT: mix, domain min / max (color_grade.glsl)
} pc;

const float PI = 3.14159265358979323846;

vec3 unpackRgb(uint p)
{
    return vec3(float(p & 0xFFu), float((p >> 8) & 0xFFu), float((p >> 16) & 0xFFu));
}

#include "color_grade.glsl"

// Bilinear equirect fetch: U wraps (the seam), V clamps (the poles) -- matches
// the viewport sampler and exportpipe::ReframeRenderer::sampleEquirect.
vec3 sampleEq(vec2 uv)
{
    float fx = uv.x * float(pc.eqW) - 0.5;
    float fy = uv.y * float(pc.eqH) - 0.5;
    float x0f = floor(fx);
    float y0f = floor(fy);
    float tx = fx - x0f;
    float ty = fy - y0f;
    int x0 = int(x0f);
    int y0 = int(y0f);

    int xa = x0 % pc.eqW; if (xa < 0) xa += pc.eqW;
    int xb = (x0 + 1) % pc.eqW; if (xb < 0) xb += pc.eqW;
    int ya = clamp(y0, 0, pc.eqH - 1);
    int yb = clamp(y0 + 1, 0, pc.eqH - 1);

    vec3 p00 = unpackRgb(eqpx[ya * pc.eqW + xa]);
    vec3 p10 = unpackRgb(eqpx[ya * pc.eqW + xb]);
    vec3 p01 = unpackRgb(eqpx[yb * pc.eqW + xa]);
    vec3 p11 = unpackRgb(eqpx[yb * pc.eqW + xb]);
    return mix(mix(p00, p10, tx), mix(p01, p11, tx), ty);
}

// Output pixel -> world-space look direction. Port of equirect.frag: view-space
// ray from the FOV, then roll about Z, pitch about X, yaw about Y, then stab.
vec3 dirFor(int px, int py)
{
    float ndcX = (float(px) + 0.5) / float(pc.outW) * 2.0 - 1.0;
    float ndcY = (float(py) + 0.5) / float(pc.outH) * 2.0 - 1.0;
    float t = tan(pc.fovY * 0.5);
    vec3 r = normalize(vec3(ndcX * t * pc.aspect, -ndcY * t, -1.0));

    float cr = cos(pc.roll), sr = sin(pc.roll);
    float cp = cos(pc.pitch), sp = sin(pc.pitch);
    float cy = cos(pc.yaw), sy = sin(pc.yaw);

    vec3 rr = vec3(r.x * cr - r.y * sr, r.x * sr + r.y * cr, r.z);
    vec3 rp = vec3(rr.x, rr.y * cp - rr.z * sp, rr.y * sp + rr.z * cp);
    return pc.stab * vec3(rp.x * cy + rp.z * sy, rp.y, -rp.x * sy + rp.z * cy);
}

vec2 uvFor(vec3 rw)
{
    float lon = atan(rw.x, -rw.z);
    float lat = asin(clamp(rw.y, -1.0, 1.0));
    return vec2(lon / (2.0 * PI) + 0.5, 0.5 - lat / PI);
}

// BT.709, limited ("TV") range, 8-bit RGB(0..255) -> YUV -- what the encoder
// tags the stream as (exportpipe::FlattenWriter) and what players assume for
// untagged HD. Was BT.601 until 2026-09-27: HD players decoded it as 709 and
// shifted reds / greens. The CPU reproject path's sws_scale is set to the same
// matrix, so both paths produce the same colour.
float lumaY(vec3 c) { return 16.0 + 0.182586 * c.r + 0.614231 * c.g + 0.062007 * c.b; }
float chromaU(vec3 c) { return 128.0 - 0.100644 * c.r - 0.338572 * c.g + 0.439216 * c.b; }
float chromaV(vec3 c) { return 128.0 + 0.439216 * c.r - 0.398942 * c.g - 0.040274 * c.b; }
uint q8(float x) { return uint(clamp(x + 0.5, 0.0, 255.0)); }

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int uintsPerRow = pc.outW / 4;
    if (gid.x >= uintsPerRow || gid.y >= pc.outH)
        return;

    int basePx = gid.x * 4;

    vec3 rgb[4];
    uint y[4];
    for (int i = 0; i < 4; ++i) {
        rgb[i] = gradeColor(sampleEq(uvFor(dirFor(basePx + i, gid.y))), pc.colorGrade, pc.colorLut, 255.0);
        y[i] = q8(lumaY(rgb[i]));
    }
    outw[gid.y * uintsPerRow + gid.x] = y[0] | (y[1] << 8) | (y[2] << 16) | (y[3] << 24);

    // Chroma is 4:2:0 -- one sample per 2x2 luma block, so only even rows write,
    // averaging this row and the next.
    if ((gid.y & 1) == 0) {
        int nextY = gid.y + 1 < pc.outH ? gid.y + 1 : gid.y;
        vec3 n0 = gradeColor(sampleEq(uvFor(dirFor(basePx + 0, nextY))), pc.colorGrade, pc.colorLut, 255.0);
        vec3 n1 = gradeColor(sampleEq(uvFor(dirFor(basePx + 1, nextY))), pc.colorGrade, pc.colorLut, 255.0);
        vec3 n2 = gradeColor(sampleEq(uvFor(dirFor(basePx + 2, nextY))), pc.colorGrade, pc.colorLut, 255.0);
        vec3 n3 = gradeColor(sampleEq(uvFor(dirFor(basePx + 3, nextY))), pc.colorGrade, pc.colorLut, 255.0);

        vec3 c0 = (rgb[0] + rgb[1] + n0 + n1) * 0.25;
        vec3 c1 = (rgb[2] + rgb[3] + n2 + n3) * 0.25;
        uint u0 = q8(chromaU(c0)), v0 = q8(chromaV(c0));
        uint u1 = q8(chromaU(c1)), v1 = q8(chromaV(c1));

        int uvBase = pc.outH * uintsPerRow;
        outw[uvBase + (gid.y >> 1) * uintsPerRow + gid.x] =
            u0 | (v0 << 8) | (u1 << 16) | (v1 << 24);
    }
}
